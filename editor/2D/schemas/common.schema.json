{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": true
    },
    "objectRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "minLength": 1
            },
            "object": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "level",
            "object"
          ],
          "additionalProperties": true
        }
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "enum",
            "color",
            "asset",
            "position",
            "objectRef"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "minimum": 1e-07
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "boolean"
        },
        "control": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlay": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "radius",
                "connection",
                "box"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "width": {
              "type": "number",
              "minimum": 1
            },
            "height": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": true
        },
        "space": {
          "enum": [
            "world",
            "local"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/property"
      }
    }
  }
}
