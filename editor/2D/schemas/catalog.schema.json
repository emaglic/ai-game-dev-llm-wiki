{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "extensions": {
      "type": "object"
    },
    "levelProperties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/property"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "tile",
              "object"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "resizable": {
            "type": "boolean"
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "minimum": 1
              },
              "height": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": true
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/property"
            }
          },
          "visual": {
            "type": "object",
            "properties": {
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "frame": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": true
              },
              "fit": {
                "enum": [
                  "contain",
                  "stretch"
                ]
              },
              "editorOnly": {
                "type": "boolean"
              },
              "bounds": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": true,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 1e-07
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1e-07
                  }
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "collision": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "shape": {
                    "enum": [
                      "rectangle",
                      "ellipse"
                    ]
                  }
                },
                "required": [
                  "shape"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "shape": {
                    "const": "polygon"
                  },
                  "points": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "shape",
                  "points"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "properties"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "version",
    "levelProperties",
    "elements"
  ],
  "additionalProperties": true
}
