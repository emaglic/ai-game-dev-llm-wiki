{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level v2 (pixel tiles)",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "editor2D": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "grid": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": true,
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 1
                },
                "y": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "number",
      "minimum": 1
    },
    "height": {
      "type": "number",
      "minimum": 1
    },
    "grid": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "object"
    },
    "layers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "tile"
              },
              "tiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "tiles"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "object"
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    },
                    "properties": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "width",
                    "height",
                    "properties"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "objects"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "tileSize": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "version",
    "id",
    "width",
    "height",
    "grid",
    "settings",
    "layers",
    "tileSize"
  ],
  "additionalProperties": true
}
