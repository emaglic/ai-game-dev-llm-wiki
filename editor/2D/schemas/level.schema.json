{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "extensions": {
      "type": "object"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "number",
      "minimum": 1
    },
    "height": {
      "type": "number",
      "minimum": 1
    },
    "grid": {
      "type": "number",
      "minimum": 1
    },
    "settings": {
      "type": "object"
    },
    "layers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "tile"
              },
              "tiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "tiles"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "object"
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    },
                    "properties": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "width",
                    "height",
                    "properties"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "objects"
            ],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "id",
    "width",
    "height",
    "grid",
    "settings",
    "layers"
  ],
  "additionalProperties": true
}
