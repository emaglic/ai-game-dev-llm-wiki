{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "level v2 (pixel tiles)",
  "type": "object",
  "properties": {
    "version": {
      "const": 3
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "editor2D": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "grid": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": true,
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 1
                },
                "y": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "number",
      "minimum": 1
    },
    "height": {
      "type": "number",
      "minimum": 1
    },
    "grid": {
      "type": "integer",
      "minimum": 1
    },
    "settings": {
      "type": "object"
    },
    "layers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "tile"
              },
              "tiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer"
                    },
                    "y": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "type",
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": true
                }
              },
              "solid": {
                "type": "boolean",
                "description": "False disables tile movement-blocking collisions on this layer. True or missing retains normal tile-type collision rules, independently of drawing order."
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "tiles"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "object"
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    },
                    "properties": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "width",
                    "height",
                    "properties"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "objects"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "kind": {
                "const": "background"
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "background-image",
                        "background-color"
                      ]
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    },
                    "properties": {
                      "type": "object",
                      "properties": {
                        "asset": {
                          "type": "string"
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "scaleX": {
                          "type": "number",
                          "minimum": 0.001
                        },
                        "scaleY": {
                          "type": "number",
                          "minimum": 0.001
                        },
                        "flipX": {
                          "type": "boolean"
                        },
                        "flipY": {
                          "type": "boolean"
                        },
                        "repeat": {
                          "type": "boolean"
                        },
                        "frame": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "height": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "width",
                            "height"
                          ],
                          "additionalProperties": true
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "x",
                    "y",
                    "width",
                    "height",
                    "properties"
                  ],
                  "additionalProperties": true
                }
              },
              "parallax": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "kind",
              "visible",
              "locked",
              "opacity",
              "objects"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "tileSize": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "version",
    "id",
    "width",
    "height",
    "grid",
    "settings",
    "layers",
    "tileSize"
  ],
  "additionalProperties": true,
  "$id": ""
}
